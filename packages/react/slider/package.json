{
  "name": "@nevidomyi/react-slider",
  "version": "1.3.8",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc",
    "react-dom": "^16.8 || ^17.0 || ^18.0 || ^19.0 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/number": "1.1.1",
    "@radix-ui/primitive": "1.1.3",
    "@radix-ui/react-collection": "1.1.8",
    "@radix-ui/react-compose-refs": "1.1.2",
    "@radix-ui/react-context": "1.1.3",
    "@radix-ui/react-direction": "1.1.1",
    "@radix-ui/react-primitive": "2.1.4",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@radix-ui/react-use-layout-effect": "1.1.1",
    "@radix-ui/react-use-previous": "1.1.1",
    "@radix-ui/react-use-size": "1.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevidomyi/radix-primitives.git"
  },
  "homepage": "https://github.com/nevidomyi/radix-primitives",
  "bugs": {
    "url": "https://github.com/nevidomyi/radix-primitives/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
